From 2024e8897e921eaa930bbcb8f151ec100b503229 Mon Sep 17 00:00:00 2001
From: Maxim Anisimov <maxim.anisimov.ua@gmail.com>
Date: Tue, 30 Jun 2026 16:55:11 +0300
Subject: [PATCH] mtd: spinand: fmsh: drop Dual/Quad I/O read ops for FM25G0XB

Fudan FM25G0XB does not reliably support generic SPI-NAND
Dual I/O (0xBB) and Quad I/O (0xEB) cache read operations
implemented through Linux spi-mem generic operation templates.

According to the vendor datasheet, both commands use vendor-specific
address/dummy/wrap framing which does not fully match the generic
spi-mem protocol.

In particular, the device multiplexes wrap bits and address bits
during the I/O address phase, while Linux generic spi-mem operations
treat them as standard address + dummy cycles.

As a result, 0xBB and especially 0xEB may fail depending on the SPI
controller implementation and dummy cycle handling.

Use the standard Quad Output Read (0x6B) operation instead, which
matches the datasheet protocol and works reliably across controllers.

Signed-off-by: Maxim Anisimov <maxim.anisimov.ua@gmail.com>
---
 drivers/mtd/nand/spi/fmsh.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

--- a/drivers/mtd/nand/spi/fmsh.c
+++ b/drivers/mtd/nand/spi/fmsh.c
@@ -36,6 +36,12 @@ static SPINAND_OP_VARIANTS(read_cache_va
 		SPINAND_PAGE_READ_FROM_CACHE_OP(true, 0, 1, NULL, 0),
 		SPINAND_PAGE_READ_FROM_CACHE_OP(false, 0, 1, NULL, 0));
 
+static SPINAND_OP_VARIANTS(read_cache_variants_fm25g0xb,
+		SPINAND_PAGE_READ_FROM_CACHE_X4_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_X2_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_OP(true, 0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_OP(false, 0, 1, NULL, 0));
+
 static SPINAND_OP_VARIANTS(write_cache_variants,
 		SPINAND_PROG_LOAD_X4(true, 0, NULL, 0),
 		SPINAND_PROG_LOAD(true, 0, NULL, 0));
@@ -193,7 +199,7 @@ static const struct spinand_info fmsh_sp
 		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_DUMMY, 0xd1),
 		     NAND_MEMORG(1, 2048, 128, 64, 1024, 21, 1, 1, 1),
 		     NAND_ECCREQ(8, 528),
-		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants_fm25g0xb,
 					      &write_cache_variants,
 					      &update_cache_variants),
 		     SPINAND_HAS_QE_BIT,
@@ -203,7 +209,7 @@ static const struct spinand_info fmsh_sp
 		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_DUMMY, 0xd2),
 		     NAND_MEMORG(1, 2048, 128, 64, 2048, 41, 1, 1, 1),
 		     NAND_ECCREQ(8, 528),
-		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants_fm25g0xb,
 					      &write_cache_variants,
 					      &update_cache_variants),
 		     SPINAND_HAS_QE_BIT,
